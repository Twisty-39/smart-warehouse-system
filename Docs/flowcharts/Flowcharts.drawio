            <mxGeometry height="39" width="237" x="1591" y="428" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="Pilihan Tindakan Pengguna" mermaidId="n:ActionAuthChoice" mermaidBaseStyle="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Pilihan Tindakan Pengguna" id="WDNYaYfzRDGCBRBGxwmt-5">
          <mxCell parent="WDNYaYfzRDGCBRBGxwmt-2" style="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1">

        <UserObject label="Peran Pengguna: Purchasing atau Admin?" mermaidId="n:CheckRole" mermaidBaseStyle="rhombus;html=1;strokeWidth=1;whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Peran Pengguna: Purchasing atau Admin?" id="pwNaDgyoyUrkyz4tYUQ2-3">
